{
  "name": "pharmacy-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "pretest": "tsx tests/setup.ts",
    "test": "tsx --import ./tests/env.ts --test --test-concurrency=1 tests/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov tsx --import ./tests/env.ts --test --test-concurrency=1 tests/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pino": "^9.4.0",
    "tsx": "^4.16.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "c8": "^12.0.0",
    "prisma": "^5.18.0",
    "typescript": "^5.5.4"
  },
  "c8": {
    "include": ["src/**/*.ts"],
    "exclude": ["src/index.ts"],
    "check-coverage": true,
    "lines": 85,
    "functions": 90,
    "branches": 65,
    "statements": 85,
    "reporter": ["text", "lcov"]
  }
}
